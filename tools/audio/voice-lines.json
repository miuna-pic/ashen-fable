[
 {
  "key": "4d164317",
  "who": "b",
  "text": "你又掉下来了。"
 },
 {
  "key": "3d0a62f7",
  "who": "b",
  "text": "第几次了？……算了，不用想。我替你数着。"
 },
 {
  "key": "024bec48",
  "who": "a",
  "text": "……你是谁？这是哪里？"
 },
 {
  "key": "582ae3d4",
  "who": "b",
  "text": "一块玻璃棋盘。你站在上面，我倒挂在下面，我们踩着同一格。你往哪走，我就在哪。"
 },
 {
  "key": "d561f75e",
  "who": "b",
  "text": "至于我是谁——等你走到第八格，自己就想起来了。每一个都是这样。"
 },
 {
  "key": "dbd5d1ce",
  "who": "a",
  "text": "地上是湿的。"
 },
 {
  "key": "f7ef7abc",
  "who": "b",
  "text": "眼泪。上一个你在这里哭了很久，哭完才肯走。"
 },
 {
  "key": "f5ef57fb",
  "who": "b",
  "text": "红心兵每一拍都会朝你挪一格。别等她站到你的斜角——你先走到她的正面去。"
 },
 {
  "key": "cd5315c0",
  "who": "b",
  "text": "处刑人。她不动，也不说话。斧头落下的地方是一整行、一整列。"
 },
 {
  "key": "8a64f0c5",
  "who": "b",
  "text": "她砍不到斜角。兵怕正面，她怕斜角。记住这两句，你能多活几格。"
 },
 {
  "key": "5db7cdef",
  "who": "cat",
  "text": "嘻。新来的爱丽丝。请坐，请坐——哎呀，没有空位子了。"
 },
 {
  "key": "cb8179b6",
  "who": "cat",
  "text": "这张桌子摆了一千八百六十五副茶具，时间停在六点钟，茶一直没凉。"
 },
 {
  "key": "3db52c83",
  "who": "a",
  "text": "杯子里的茶……是黑的。"
 },
 {
  "key": "988ff218",
  "who": "cat",
  "text": "那是墨。你刚才吃掉红心兵的时候，她流出来的可不是血。"
 },
 {
  "key": "00d82d9b",
  "who": "cat",
  "text": "镜子下面那位，就靠喝这个走路。"
 },
 {
  "key": "cdc020a3",
  "who": "cat",
  "text": "看见地上那些虚线的叉了吗？那是玻璃另一面的客人在瞄准你。"
 },
 {
  "key": "863a5da8",
  "who": "cat",
  "text": "你看不清她们，她们照样咬得到你。两面的红格，哪一面的都别踩。"
 },
 {
  "key": "907758f6",
  "who": "b",
  "text": "那只猫的话只能信一半。——这一半是真的。"
 },
 {
  "key": "c45ee7c4",
  "who": "b",
  "text": "我的杯子空了。"
 },
 {
  "key": "322e6b89",
  "who": "b",
  "text": "想让我带你滑两次，你就得先替我杀两个。杀人是你的活，逃命是我的活。"
 },
 {
  "key": "0139b7b1",
  "who": "a",
  "text": "……你说得好像理所当然。"
 },
 {
  "key": "668bfa0d",
  "who": "b",
  "text": "因为一直都是这样。"
 },
 {
  "key": "22522218",
  "who": "b",
  "text": "听见了？她在前面。槌球场上的球门是人弯成的，弯不动了就换一个。"
 },
 {
  "key": "0395b7f1",
  "who": "b",
  "text": "明面上的人挡得住你，挡不住我。我在玻璃下面，从她们脚底滑过去。"
 },
 {
  "key": "450824d5",
  "who": "b",
  "text": "明面的敌人只有你能吃，镜面的敌人只有我能吃。"
 },
 {
  "key": "2fa2baa1",
  "who": "b",
  "text": "还有一条：我们谁也不能停在对面有人的格子上。脚下踩着别人，是站不稳的。"
 },
 {
  "key": "836b23df",
  "who": "cat",
  "text": "嘻，所以要翻来翻去呀。一个开路，一个收尸。"
 },
 {
  "key": "cf2130e8",
  "who": "a",
  "text": "那里……躺着一个人。她穿着和我一样的裙子。"
 },
 {
  "key": "e0e3c01c",
  "who": "b",
  "text": "第一千八百六十五个。走到这里，偏了一格。"
 },
 {
  "key": "27b8acb9",
  "who": "b",
  "text": "别难过。遗骸挡得住处刑人的斧线——她现在比活着的时候有用。"
 },
 {
  "key": "148b32a8",
  "who": "a",
  "text": "……"
 },
 {
  "key": "04cd2ec6",
  "who": "b",
  "text": "你死过的地方，也会留下一具。死得好，也是一步棋。"
 },
 {
  "key": "b41d336d",
  "who": "cat",
  "text": "好啦，课上完了，考试。口试，不许带白兔，不许带小抄。"
 },
 {
  "key": "a8aec38a",
  "who": "cat",
  "text": "五道题，每道题只给你刚刚好的步数。答对了，我告诉你一件她不肯说的事。"
 },
 {
  "key": "62ea7d94",
  "who": "cat",
  "text": "第一问：两步之内，戴上王冠。"
 },
 {
  "key": "f72a09c1",
  "who": "cat",
  "text": "第二问：你的墨是空的。三步。"
 },
 {
  "key": "eab92749",
  "who": "cat",
  "text": "第三问：谁吃谁，想清楚再动。三步。"
 },
 {
  "key": "94aac86a",
  "who": "cat",
  "text": "第四问：四步。玻璃两面的红格，都算数。"
 },
 {
  "key": "1dcdb216",
  "who": "cat",
  "text": "最后一问：四步。地上那位，不是白躺着的。"
 },
 {
  "key": "06457d95",
  "who": "b",
  "text": "钟一响，盘上所有棋子都会掉到玻璃另一面去。明面的掉到我这边，我这边的翻到你那边。"
 },
 {
  "key": "8b4d8d73",
  "who": "b",
  "text": "她们砍的格子不变。变的是——谁吃得到她们。"
 },
 {
  "key": "6af9505c",
  "who": "a",
  "text": "等了多久？"
 },
 {
  "key": "2e71e858",
  "who": "b",
  "text": "……看路。"
 },
 {
  "key": "3f1a32b4",
  "who": "b",
  "text": "别看。"
 },
 {
  "key": "c91cda96",
  "who": "a",
  "text": "为什么？"
 },
 {
  "key": "65941da1",
  "who": "b",
  "text": "……看了你就下不去手了。走。"
 },
 {
  "key": "fa5638f8",
  "who": "b",
  "text": "她说得对。红格只是提醒，规矩从来不靠它。你已经背下来了。"
 },
 {
  "key": "f4e05210",
  "who": "a",
  "text": "……看见了你，镜子里的。火光一照，你的脸——"
 },
 {
  "key": "8d0c4478",
  "who": "b",
  "text": "和你一模一样。你以为镜子里的是影子？"
 },
 {
  "key": "e77e299f",
  "who": "b",
  "text": "先掉下来的是我。"
 },
 {
  "key": "6d530d9b",
  "who": "b",
  "text": "……"
 },
 {
  "key": "f59f258d",
  "who": "b",
  "text": "每一个你死了，就留在盘上。我不会。我掉回原地，等下一个掉下来，再从第一格陪她走。"
 },
 {
  "key": "cff63acf",
  "who": "b",
  "text": "所以我说，我替你数着。"
 },
 {
  "key": "a32cce39",
  "who": "a",
  "text": "爱丽丝。……用处？"
 },
 {
  "key": "4fe89d07",
  "who": "b",
  "text": "别低头。她们挡得住斧线，我滑不过去，你也跨不过去。绕着走。"
 },
 {
  "key": "e30ebcb5",
  "who": "b",
  "text": "这一盘，活着是过不去的。"
 },
 {
  "key": "1b48cea0",
  "who": "a",
  "text": "什么意思？"
 },
 {
  "key": "5cc18f40",
  "who": "b",
  "text": "斧线之间没有缝。得有人躺在那条线上，后面的人才走得过去。"
 },
 {
  "key": "f4f02933",
  "who": "b",
  "text": "去死一次。挑一个好地方。我在原地等你——我一直都在等你。"
 },
 {
  "key": "db5a4766",
  "who": "a",
  "text": "……是你吗？"
 },
 {
  "key": "4cef6d65",
  "who": "b",
  "text": "这一盘要死两次。别问了。"
 },
 {
  "key": "f940da16",
  "who": "a",
  "text": "我是……我叫……"
 },
 {
  "key": "46c4f5b2",
  "who": "b",
  "text": "你叫爱丽丝。"
 },
 {
  "key": "82435d41",
  "who": "a",
  "text": "那你呢？"
 },
 {
  "key": "43c610f2",
  "who": "b",
  "text": "…………我也是。"
 },
 {
  "key": "3aab9ef3",
  "who": "b",
  "text": "从这里开始，我不等你按翻面了。你走一步，我走一步。我有墨就走，没墨才轮到你连着走。"
 },
 {
  "key": "3a76e870",
  "who": "a",
  "text": "上一个……？"
 },
 {
  "key": "1a701cb1",
  "who": "b",
  "text": "走了。轮到我了。"
 },
 {
  "key": "c15b1cfa",
  "who": "a",
  "text": "跨过这条小溪，就是第八格。"
 },
 {
  "key": "01f3332a",
  "who": "a",
  "text": "……你一直抢着走。你想干什么？"
 },
 {
  "key": "aefacdf3",
  "who": "b",
  "text": "我在下面走了一千八百六十五趟。每一趟都看着上面那个被砍掉头。"
 },
 {
  "key": "5c8e2315",
  "who": "b",
  "text": "到了第八格，棋盘会最后翻一次。我想，这一次翻过去，就不翻回来了。"
 },
 {
  "key": "0849147a",
  "who": "b",
  "text": "——换我在上面。你恨我也行。"
 },
 {
  "key": "f69ddbd3",
  "who": "a",
  "text": "审理都没有，凭什么判决？"
 },
 {
  "key": "705f3112",
  "who": "b",
  "text": "……先过了这道门再说。"
 },
 {
  "key": "6f2fc30b",
  "who": "b",
  "text": "她的影子在我这一面。影子活着，你就碰不到她，她的视线也没有死角。"
 },
 {
  "key": "71f4e7b4",
  "who": "b",
  "text": "先让我杀了影子。失去影子的女王只看得见横竖——然后你从斜里走过去，把这盘棋下完。"
 },
 {
  "key": "d0b582fa",
  "who": "cat",
  "text": "嘻。棋盘中间那道裂缝，为什么也亮着呢？我可什么都没说哦。"
 },
 {
  "key": "5b67280a",
  "who": "b",
  "text": "第一格。……比上一个快。"
 },
 {
  "key": "64d721af",
  "who": "b",
  "text": "别高兴。前面那张桌子，一步一步是走不过去的。"
 },
 {
  "key": "b427b079",
  "who": "cat",
  "text": "茶喝完了？那就去打槌球吧。女王陛下最讨厌迟到的球。"
 },
 {
  "key": "55059e52",
  "who": "cat",
  "text": "也最讨厌准时的。嘻。"
 },
 {
  "key": "c813c9ee",
  "who": "cat",
  "text": "及格。说好的，告诉你一件事。"
 },
 {
  "key": "dd417786",
  "who": "cat",
  "text": "红心兵为什么蒙着眼睛？——因为她们认得你的脸。"
 },
 {
  "key": "e8da2538",
  "who": "b",
  "text": "……猫。"
 },
 {
  "key": "1e5200da",
  "who": "cat",
  "text": "好好好，我消失，我消失。先从尾巴开始。"
 },
 {
  "key": "4845897f",
  "who": "a",
  "text": "我不恨你。"
 },
 {
  "key": "9e188ab4",
  "who": "a",
  "text": "可是你上去了，下面的就是我。然后呢？你再替下一个数？"
 },
 {
  "key": "80e10603",
  "who": "b",
  "text": "…………走吧。女王在等。"
 },
 {
  "key": "08a63f02",
  "who": "a",
  "text": "……将军。"
 },
 {
  "key": "b2b3ec54",
  "who": "a",
  "text": "你也……数过？"
 },
 {
  "key": "09be1089",
  "who": "b",
  "text": "这次……换你在上面了。也好。至少……不用再……数……"
 },
 {
  "key": "ae52406d",
  "who": "cat",
  "text": "恭喜升变，女王陛下。第一千八百六十七个已经在路上了。"
 },
 {
  "key": "a65fbdc8",
  "who": "cat",
  "text": "……对了。棋盘中间那道裂缝，到最后你也没去踩。下次要不要试试——别杀影子？"
 },
 {
  "key": "82c14ba9",
  "who": "a",
  "text": "我不要王冠。"
 },
 {
  "key": "6ba286d5",
  "who": "a",
  "text": "那就不赢。"
 },
 {
  "key": "d9596e17",
  "who": "a",
  "text": "手给我。"
 },
 {
  "key": "8137167c",
  "who": "b",
  "text": "……我们不能站在同一面。你知道的。从第三格你就知道。"
 },
 {
  "key": "dfe8732d",
  "who": "a",
  "text": "我知道。所以才要这么走。"
 },
 {
  "key": "15f0267a",
  "who": "b",
  "text": "{n}。……我可以不数了吗？"
 },
 {
  "key": "5b5d1acd",
  "who": "a",
  "text": "嗯。不数了。"
 },
 {
  "key": "d7e0652b",
  "who": "cat",
  "text": "棋盘碎了，棋子就只是两个女孩子。嘻——这一页，连我也没读过。"
 },
 {
  "key": "aa33ae45",
  "who": "b",
  "text": "先学走路。你一次只能走一格，像个没用的王。往前。"
 },
 {
  "key": "833c4783",
  "who": "b",
  "text": "红心兵挪过来了。染红的格子，是她下一拍要砍的地方。……不信？踩上去试试。"
 },
 {
  "key": "095fa9af",
  "who": "b",
  "text": "看见了吗。躺在那里的，是上一个你。遗骸会一直留在盘上。——再来，往前。"
 },
 {
  "key": "2f2ff571",
  "who": "b",
  "text": "她只砍斜角，正面是死角。走到她的格子上，吃掉她。"
 },
 {
  "key": "acb60824",
  "who": "b",
  "text": "吃子会涨一滴墨，以后用得上。现在，走到最远那一格，戴上王冠。"
 },
 {
  "key": "b4523698",
  "who": "cat",
  "text": "处刑人的斧线横在中间，你一步一格是跨不过去的。按下「翻面」。"
 },
 {
  "key": "a1af955d",
  "who": "cat",
  "text": "现在是镜子里那位领路。她像女王一样一滑到底，中途不停，所以斧线拦不住她。滑到对面去。"
 },
 {
  "key": "602acb0d",
  "who": "cat",
  "text": "她每滑一次，喝掉一滴墨。看左下角——空了。没有墨，她一步也动不了。翻回去。"
 },
 {
  "key": "2dea762a",
  "who": "b",
  "text": "墨只有你在明面吃子才会涨。旁边那个红心兵，吃掉她。"
 },
 {
  "key": "788fabc7",
  "who": "b",
  "text": "墨回来了。怎么用，你自己决定。去拿王冠。"
 },
 {
  "key": "c9b074b6",
  "who": "b",
  "text": "两个处刑人互相看守，你吃哪一个都会被另一个砍。明面过不去。翻面。"
 },
 {
  "key": "9e81712b",
  "who": "b",
  "text": "我在玻璃下面。明面的棋子挡不住我——从她脚底下斜着滑过去。"
 },
 {
  "key": "a9598864",
  "who": "b",
  "text": "记住：我能从她们脚下经过，但不能停在她们脚下。去拿王冠。"
 },
 {
  "key": "2f202377",
  "who": "b",
  "text": "红心兵砍的是四个斜角。你走进了她的斜角。"
 },
 {
  "key": "fa6faf40",
  "who": "b",
  "text": "别站到兵的斜角上去。从正面吃她。"
 },
 {
  "key": "a00965fd",
  "who": "b",
  "text": "处刑人的斧线是一整行、一整列。你踩在线上了。"
 },
 {
  "key": "53c6f388",
  "who": "b",
  "text": "斧线只被棋子、碎洞和遗骸挡住。你不是其中任何一样——现在是了。"
 },
 {
  "key": "f9720447",
  "who": "b",
  "text": "影子活着，女王八个方向都看得见。"
 },
 {
  "key": "6a32828e",
  "who": "b",
  "text": "失去影子的女王只看横竖。你走的是横竖。"
 },
 {
  "key": "a9dc6414",
  "who": "b",
  "text": "那是玻璃另一面的空壳兵。虚线的叉，也是会砍头的。"
 },
 {
  "key": "f9f9e338",
  "who": "b",
  "text": "镜面的兵同样砍斜角。两面的红格都算数。"
 },
 {
  "key": "883435b8",
  "who": "b",
  "text": "无头骑士走日字，落点就是斩击点。"
 },
 {
  "key": "a84c72a1",
  "who": "b",
  "text": "日字的八个落点，记不住就数一遍再走。"
 },
 {
  "key": "009860c5",
  "who": "b",
  "text": "柴郡猫咬住的是整条斜线，从玻璃下面。"
 },
 {
  "key": "334f9218",
  "who": "b",
  "text": "斜线上没有东西挡着，它就够得到你。"
 },
 {
  "key": "870e07dc",
  "who": "b",
  "text": "女王之影守着她身边一圈。别从正面靠近影子。"
 },
 {
  "key": "4fbd282a",
  "who": "b",
  "text": "影子只守一圈。站在圈外，用我去吃她。"
 },
 {
  "key": "cbef5b45",
  "who": "cat",
  "text": "步数用完了。这道题有更短的走法。"
 },
 {
  "key": "2d6d6fa1",
  "who": "cat",
  "text": "不及格。再想一想：谁吃谁，谁滑得过去。"
 }
]
